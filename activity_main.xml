<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F4FAF6" android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="18dp">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="SHARMA PHARMACY" android:textStyle="bold"
            android:textSize="26sp" android:textColor="#075C42" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="MODINAGAR • Your Trusted Health Partner"
            android:textSize="14sp" android:textColor="#47665A"
            android:layout_marginBottom="18dp" />
        <EditText
            android:id="@+id/searchInput" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:hint="Search medicine name"
            android:singleLine="true" android:inputType="text"
            android:padding="12dp" android:backgroundTint="#16845B" />
        <Button
            android:id="@+id/importCsvButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="ADMIN: Import stock CSV"
            android:backgroundTint="#16845B" android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/stockInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Stock not imported yet. Select a CSV file."
            android:textColor="#33483E" android:paddingTop="8dp" android:paddingBottom="8dp" />
        <TextView
            android:id="@+id/medicineResults" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Medicine list will appear here."
            android:textColor="#172B22" android:textSize="15sp"
            android:padding="10dp" />
        <View android:layout_width="match_parent" android:layout_height="1dp"
            android:background="#C8DED1" android:layout_marginTop="8dp" android:layout_marginBottom="12dp" />
        <Button
            android:id="@+id/pickPrescriptionButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Choose prescription photo"
            android:backgroundTint="#2476A8" android:textColor="#FFFFFF" />
        <TextView
            android:id="@+id/prescriptionInfo" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="No prescription photo selected."
            android:textColor="#33483E" android:padding="6dp" />
        <Button
            android:id="@+id/whatsappButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Send order / prescription on WhatsApp"
            android:backgroundTint="#16845B" android:textColor="#FFFFFF" />
        <Button
            android:id="@+id/deliveryButton" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="Home delivery & contact"
            android:backgroundTint="#075C42" android:textColor="#FFFFFF" />
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Prescription medicines are supplied only after pharmacist/legal checks. Stock and prices depend on the latest file and must be confirmed by the pharmacy."
            android:textSize="12sp" android:textColor="#5C6D64"
            android:layout_marginTop="16dp" android:paddingBottom="12dp" />
    </LinearLayout>
</ScrollView>
